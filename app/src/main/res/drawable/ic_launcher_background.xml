        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FF3D7DF5" />
                <item android:offset="1" android:color="#FF2557CE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Deep navy panel beside the spine -->
    <path android:fillColor="#FF2E3AA3" android:pathData="M33,0 L72,0 L33,74 Z" />

    <!-- Spine -->
    <path android:pathData="M0,0 L33,0 L33,108 L0,108 Z">
